# Copy this file to backend/.env.local and fill in real values.
# backend/.env.local is gitignored — never commit real secrets.
# scripts/services.ps1 loads this file into the environment before starting
# each Spring Boot service. Everything not set here already defaults to
# localhost in each service's application.yml.

# Shared JWT signing secret (must be the same for api-gateway and auth-service).
# The application.yml default already works for local dev; only override if you want a fixed value.
JWT_SECRET=dev-only-secret-change-me-please-32bytes+

# Frontend origin allowed by the gateway's CORS config.
CORS_ALLOWED_ORIGINS=http://localhost:5192

# Stripe (payment-service) — use TEST keys only for local dev.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=inr

# Resend (notification-service) — leave blank to no-op email sending locally.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=SpicyEat <onboarding@resend.dev>
